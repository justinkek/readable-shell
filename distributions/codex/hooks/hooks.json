{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(Bash|apply_patch)$",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/hooks/guard-shell-readability.sh\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/hooks/note-a-new-version.sh\""
					},
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/hooks/replay-notes.sh\""
					}
				]
			}
		]
	}
}
